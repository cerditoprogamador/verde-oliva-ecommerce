# Copiar a api/.env y completar con valores reales. api/.env NUNCA se commitea
# (ver api/.gitignore) — este archivo es solo la plantilla.

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (tipo "Web application"). Solo hace falta el Client ID, no el Client Secret:
# el backend verifica ID tokens de Google Identity Services, no hace el
# flujo completo de authorization-code.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Mercado Pago > panel de developers (https://www.mercadopago.com.ar/developers) >
# Tus integraciones > la app > Credenciales. Usar primero las de PRUEBA
# (sandbox), nunca las de produccion hasta el final (ver plan aprobado, Fase 4/5).
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# String random largo para firmar la cookie de sesion. Generar uno propio,
# por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=reemplazar-con-un-string-random-largo

# MySQL — mismos datos que el hosting (Hostinger hPanel > Databases) o tu
# MySQL local en desarrollo.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=verde_oliva

# Puerto donde escucha el proceso Node. En Hostinger el Node.js Selector
# suele fijar su propio puerto/proxy — revisar la doc del panel al desplegar.
PORT=3000

# Opcional: URL publica base del sitio (https://tu-dominio.com), usada para
# armar back_urls/notification_url de Mercado Pago. Si no se define, el
# servidor arma la URL a partir del host del propio request (funciona en
# local; en produccion detras de un proxy conviene fijarla explicita).
PUBLIC_BASE_URL=

# development | production — solo en production se activa la cookie
# `secure` (requiere HTTPS). Dejar sin definir o en "development" en local.
NODE_ENV=development

# Cuenta del panel de administrador (separada del login Google de clientes).
# Solo se usan para correr `node scripts/seed-admin.js` una vez: ese script
# hashea ADMIN_PASSWORD con bcryptjs y lo guarda en la tabla admin_users.
# Despues de correrlo, se puede borrar ADMIN_PASSWORD de este archivo — solo
# el hash en la base importa de ahi en mas.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SMTP para el mail de confirmacion de compra (ver api/lib/mailer.js). Usar
# la casilla de tu hosting (ej. Hostinger: smtp.hostinger.com, puerto 465
# con SMTP_SECURE=true, o 587 con SMTP_SECURE=false) o cualquier otra SMTP.
# Si se dejan vacias, el servidor arranca igual pero no manda mails (queda
# logueado un warning una sola vez).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Verde Oliva Olivoterapia <pedidos@tudominio.com>"
